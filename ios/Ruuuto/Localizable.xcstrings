        "ja": { "stringUnit": { "state": "translated", "value": "都市なし" } }
      }
    },
    "boards.photos.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This board is closed, so photos can’t be moved." } },
        "ja": { "stringUnit": { "state": "translated", "value": "締め切られたボードの写真は移動できません。" } }
      }
