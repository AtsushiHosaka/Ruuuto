        "ja": { "stringUnit": { "state": "translated", "value": "グループのみんなが投稿した写真がここに表示されます。" } }
      }
    },
    "boards.photos.fixed_background": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Background photos are fixed in place." } },
        "ja": { "stringUnit": { "state": "translated", "value": "背景に設定された写真は移動できません。" } }
      }
    },
    "boards.photos.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You don’t have permission to edit this board." } },
