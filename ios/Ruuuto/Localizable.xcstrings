        "ja": { "stringUnit": { "state": "translated", "value": "その位置を保存できませんでした。" } }
      }
    },
    "boards.photos.load_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn’t load the board’s photos." } },
