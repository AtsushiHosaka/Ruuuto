    },
    "boards.photos.lost_lock": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The move took too long. Try moving the photo again." } },
        "ja": { "stringUnit": { "state": "translated", "value": "移動の有効時間が切れました。もう一度動かしてください。" } }
      }
    },
