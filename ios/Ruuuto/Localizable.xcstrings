  "strings": {
    "boards.current.group_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the board for the selected group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだグループのボードを表示できませんでした。"
          }
        }
      }
    },
    "boards.current.load_failed": {
      "extractionState": "manual",
      "localizations": {
