      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn’t move the photo" } },
        "ja": { "stringUnit": { "state": "translated", "value": "写真を移動できませんでした" } }
      }
    },
    "boards.photos.move_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The photo returned to its previous position. Try again." } },
        "ja": { "stringUnit": { "state": "translated", "value": "写真を元の位置に戻しました。もう一度お試しください。" } }
