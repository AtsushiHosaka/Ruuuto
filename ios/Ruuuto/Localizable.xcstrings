      }
    },
    "boards.photos.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Another participant is moving that photo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "その写真はほかの参加者が移動中です。" } }
