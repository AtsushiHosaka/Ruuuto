        "ja": { "stringUnit": { "state": "translated", "value": "共有写真ボード" } }
      }
    },
    "boards.photos.accessibility.locked_photo": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photo being moved by another participant" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ほかの参加者が移動中の写真" } }
      }
    },
    "boards.photos.accessibility.move_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Drag to move this photo on the board." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ドラッグしてボード上の写真を移動します。" } }
