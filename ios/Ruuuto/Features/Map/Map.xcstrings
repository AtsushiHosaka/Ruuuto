  "strings": {
    "photos.city.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "photos.city.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t Add a City"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市を指定しない"
          }
        }
      }
    },
    "photos.city.none.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can post without a city. The photo won’t appear on the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市を指定しなくても投稿できます。その写真はマップには表示されません。"
          }
        }
      }
    },
    "photos.city.row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市"
          }
        }
      }
    },
    "photos.city.row.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the city shown on the map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップに表示する都市を選びます"
          }
        }
      }
    },
    "photos.city.row.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定しない"
          }
        }
      }
    },
    "photos.city.search.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your city isn’t listed, search for the country and choose a region such as “Northern” or “Central”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧にない場所は、国名で探して「北部」「中部」などの地域を選んでください。"
          }
        }
      }
    },
    "photos.city.search.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search cities or countries"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市名・国名で探す"
          }
        }
      }
    },
    "photos.city.selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中"
          }
        }
      }
    },
    "photos.city.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a City"
