          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定しない"
          }
        }
      }
    },
    "photos.city.search.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your city isn’t listed, search for the country and choose a region such as “Northern” or “Central”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧にない場所は、国名で探して「北部」「中部」などの地域を選んでください。"
          }
        }
      }
    },
    "photos.city.search.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search cities or countries"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市名・国名で探す"
          }
        }
      }
    },
    "photos.city.selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中"
          }
        }
      }
    },
    "photos.city.title": {
      "extractionState": "manual",
      "localizations": {
