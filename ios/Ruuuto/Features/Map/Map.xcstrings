{
  "sourceLanguage": "ja",
  "strings": {
    "map.city.count %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos: %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚"
          }
        }
      }
    },
    "map.city.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Photos in This City"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この都市の写真はもうありません"
          }
        }
      }
    },
    "map.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "map.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a city when you post, and a pin appears here. Photos without a city appear only on the board."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するときに都市を選ぶと、ここにピンが立ちます。都市を指定しない写真はボードだけに載ります。"
          }
        }
      }
    },
    "map.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Photos with a City Yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市が付いた写真はまだありません"
          }
        }
      }
    },
    "map.load_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Load the Map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップを読み込めませんでした"
          }
        }
      }
    },
    "map.photo.label %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo by %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんの写真"
          }
        }
      }
    },
    "map.pin %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, photos: %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、写真%2$lld枚"
          }
        }
      }
    },
    "map.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度読み込む"
          }
        }
      }
    },
    "map.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップ"
          }
        }
      }
    },
    "photos.city.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "photos.city.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t Add a City"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市を指定しない"
          }
        }
      }
    },
    "photos.city.none.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can post without a city. The photo won’t appear on the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市を指定しなくても投稿できます。その写真はマップには表示されません。"
          }
        }
      }
    },
    "photos.city.row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市"
          }
        }
      }
    },
    "photos.city.row.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the city shown on the map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップに表示する都市を選びます"
          }
        }
