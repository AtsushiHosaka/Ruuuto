{
  "sourceLanguage": "ja",
  "strings": {
    "photos.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is turned off. Allow it in Settings, or choose a photo from your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの使用が許可されていません。設定アプリで許可するか、ライブラリから写真を選んでください。"
          }
        }
      }
    },
    "photos.camera.open_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "photos.camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn’t available on this device. Choose a photo from your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではカメラを使えません。ライブラリから写真を選んでください。"
          }
        }
      }
    },
    "photos.post.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take Photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影する"
          }
        }
      }
    },
    "photos.post.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "photos.post.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリから選ぶ"
          }
        }
      }
    },
    "photos.post.choose_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Another Photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真を選ぶ"
          }
        }
      }
    },
    "photos.post.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take or choose one photo for this week’s prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お題に合う写真を撮影するか、ライブラリから1枚選んでください。"
          }
        }
      }
    },
    "photos.post.entry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post a Photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を投稿"
          }
        }
      }
    },
    "photos.post.error.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This board has closed, so you can’t post to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締切を過ぎたため、このボードには投稿できません。"
          }
        }
      }
    },
    "photos.post.error.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have permission to post to this board."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボードに投稿する権限がありません。"
          }
        }
      }
    },
    "photos.post.error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t post this photo. Choose another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を投稿できませんでした。別の写真を選んでください。"
          }
        }
      }
    },
    "photos.post.error.retryable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t send the photo. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を送れませんでした。通信状態を確かめて、もう一度お試しください。"
          }
        }
      }
    },
    "photos.post.error.too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is too large to send. Choose another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が大きすぎて送れません。別の写真を選んでください。"
          }
        }
      }
    },
    "photos.post.error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load this photo. Choose another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は読み込めませんでした。別の写真を選んでください。"
          }
        }
      }
    },
    "photos.post.error.withdrawn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo was withdrawn. Choose another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は取り下げ済みです。別の写真を選んでください。"
          }
        }
      }
    },
    "photos.post.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location and other camera data are removed before the photo is sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報などの撮影データは消してから送ります。"
          }
        }
      }
    },
    "photos.post.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the photo…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込んでいます"
          }
        }
      }
    },
    "photos.post.preview_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview of the photo to post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿する写真のプレビュー"
          }
        }
      }
    },
    "photos.post.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度投稿"
          }
        }
      }
    },
    "photos.post.step %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posting (%1$lld of %2$lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿しています（%1$lld/%2$lld）"
          }
        }
      }
    },
    "photos.post.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿"
          }
        }
      }
    },
    "photos.post.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post a Photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を投稿"
          }
        }
      }
    }
  },
  "version": "1.0"
}
